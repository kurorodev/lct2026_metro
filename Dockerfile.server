FROM python:3.11-slim-bookworm@sha256:a36c24f9cbdf4fd0f52d67f0823eeac19c2028c637cecc392d97f980d4fec56b
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1
WORKDIR /app
COPY requirements-runtime.txt requirements-analysis.txt ./
RUN pip install --no-cache-dir -r requirements-runtime.txt -r requirements-analysis.txt
COPY pyproject.toml setup.py ./
COPY metro_guard ./metro_guard
RUN pip install --no-cache-dir --no-deps .
COPY config ./config
COPY scripts ./scripts
COPY tests ./tests
RUN python -m unittest discover -s tests -v
USER 1000:1000
ENTRYPOINT ["python", "-m", "metro_guard.cli"]
CMD ["--help"]
