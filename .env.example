# Run scripts/server.sh init to create .env with your actual UID/GID.
APP_UID=1000
APP_GID=1000
METRO_IMAGE=metro-guard:server
DATA_DIR=./data
OUTPUT_DIR=./outputs
BAG_NAME=cloud_with_fake_obj
RUN_NAME=cloud-mounted
CONFIG_FILE=./config/mounted_lidar.json
# Localhost by default. Access remotely using an SSH tunnel.
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
# Preview sampling affects only the browser export, not detection.
EXPORT_EVERY=10
PREVIEW_POINTS=2000
